<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · DataDigest report</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;600;700&display=swap">
<script src="{{ plotly_js }}"></script>
<style>
  :root { --bg:#070a12; --glass:rgba(15,22,36,.78); --edge:rgba(148,163,184,.14); --edge2:rgba(148,163,184,.08);
          --txt:#e6edf3; --sub:#93a1b4; --dim:#64748b; --cyan:#22d3ee; --violet:#a78bfa; --green:#10e39a;
          --amber:#ffc857; --red:#ff4d6d; --r:16px; color-scheme: dark;
          --font:"Inter",system-ui,-apple-system,"Segoe UI",sans-serif; --mono:"Roboto Mono",ui-monospace,Consolas,monospace; }
  * { box-sizing:border-box; }
  body { margin:0; font:14px/1.55 var(--font); background:var(--bg); color:var(--txt); -webkit-font-smoothing:antialiased; }
  body::before { content:""; position:fixed; inset:0; z-index:-1; pointer-events:none;
    background: radial-gradient(1100px 560px at 10% -10%, rgba(34,211,238,.11), transparent 60%),
                radial-gradient(900px 500px at 95% 0%, rgba(167,139,250,.11), transparent 60%); }
  main { max-width:1100px; margin:0 auto; padding:40px 20px 64px; }
  .brand { font:700 13px var(--font); letter-spacing:.14em; text-transform:uppercase; color:var(--sub); }
  .brand b { background:linear-gradient(90deg,var(--cyan),var(--violet)); -webkit-background-clip:text; background-clip:text; color:transparent; }
  h1 { margin:6px 0 4px; font-size:30px; letter-spacing:-.015em; overflow-wrap:anywhere; }
  h2 { display:flex; align-items:center; gap:9px; margin:40px 0 14px; font-size:17px; color:#c9d4e3; }
  h2::before { content:""; width:4px; height:15px; border-radius:3px; background:linear-gradient(180deg,var(--cyan),var(--violet)); box-shadow:0 0 10px rgba(34,211,238,.7); }
  .muted { color:var(--sub); }
  .chips { display:flex; gap:8px; flex-wrap:wrap; margin-top:12px; }
  .chip { font:600 12px var(--mono); padding:3px 10px; border-radius:999px; background:rgba(255,255,255,.05); border:1px solid var(--edge); color:var(--sub); }
  .card, .tile { background:var(--glass); border:1px solid var(--edge); border-radius:var(--r);
                 box-shadow:inset 0 1px 0 rgba(255,255,255,.06), 0 14px 40px rgba(0,0,0,.32); }
  .bento { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; margin-top:24px; }
  .tile { padding:16px 18px; }
  .tile.span2 { grid-column:span 2; display:flex; align-items:center; gap:20px; }
  .k { font-size:11px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--sub); }
  .v { margin-top:8px; font:700 28px/1.05 var(--mono); background:linear-gradient(180deg,#fff 20%,#bdf4ff 75%,#67e8f9);
       -webkit-background-clip:text; background-clip:text; color:transparent; }
  .ring { position:relative; width:96px; height:96px; flex:none; }
  .ring svg { width:100%; height:100%; transform:rotate(-90deg); }
  .ring circle { fill:none; stroke-width:9; }
  .ring .arc { stroke:var(--c); stroke-linecap:round; filter:drop-shadow(0 0 6px var(--c)); }
  .ring span { position:absolute; inset:0; display:grid; place-content:center; font:700 26px var(--mono); }
  .issue { display:flex; gap:10px; padding:10px 12px; margin:8px 0; border-radius:11px; background:rgba(255,255,255,.03);
           border:1px solid var(--edge2); border-left:3px solid var(--amber); }
  .ok { color:var(--green); font-weight:600; }
  .table-wrap { overflow-x:auto; }
  table { width:100%; border-collapse:collapse; }
  th, td { text-align:left; padding:10px 16px; border-bottom:1px solid var(--edge2); font-variant-numeric:tabular-nums; }
  th { font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--sub); }
  tr:last-child td { border-bottom:0; }
  td a { color:var(--txt); font-weight:600; }
  .kind { display:inline-block; padding:1px 9px; border-radius:999px; font:600 11.5px var(--mono); border:1px solid var(--edge); color:var(--sub); }
  .kind.numeric { color:var(--cyan); border-color:rgba(34,211,238,.35); }
  .kind.categorical { color:var(--violet); border-color:rgba(167,139,250,.35); }
  .kind.datetime { color:var(--green); border-color:rgba(16,227,154,.35); }
  .kind.boolean { color:var(--amber); border-color:rgba(255,200,87,.35); }
  .card { padding:18px 20px; margin:14px 0; }
  .col-grid { display:grid; grid-template-columns:minmax(220px,1fr) 2fr; gap:20px; }
  dl { display:grid; grid-template-columns:auto 1fr; gap:4px 14px; margin:12px 0 0; font-size:13.5px; }
  dt { color:var(--sub); } dd { margin:0; font-family:var(--mono); overflow-wrap:anywhere; }
  .chart { min-height:300px; }
  footer { margin-top:48px; font-size:12.5px; color:var(--dim); text-align:center; }
  @media (max-width:760px) { .bento { grid-template-columns:1fr 1fr; } .tile.span2 { grid-column:1/-1; } .col-grid { grid-template-columns:1fr; } }
  @media print { body::before { display:none; } .card, .tile { box-shadow:none; break-inside:avoid; } }
</style>
</head>
<body>
<main>
  <div class="brand"><b>DataDigest</b> · data-quality report</div>
  <h1>{{ title }}</h1>
  <div class="muted">Generated {{ generated_at }}</div>
  <div class="chips">
    <span class="chip">{{ summary.encoding }}</span>
    <span class="chip">sep {{ "TAB" if summary.delimiter == "\t" else summary.delimiter }}</span>
    {% for kind, n in summary.kinds.items() %}<span class="chip">{{ n }} {{ kind }}</span>{% endfor %}
    {% if summary.truncated %}<span class="chip">truncated to row limit</span>{% endif %}
  </div>

  {% set q = summary.quality %}
  {% set colors = {"A": "#10e39a", "B": "#22d3ee", "C": "#ffc857", "D": "#ff4d6d"} %}
  {% set labels = {"A": "Clean", "B": "Good", "C": "Needs attention", "D": "Poor"} %}
  <div class="bento">
    {% if q %}
    <div class="tile span2" style="--c: {{ colors[q.grade] }}">
      <div class="ring">
        <svg viewBox="0 0 104 104"><circle cx="52" cy="52" r="46" stroke="rgba(255,255,255,.07)"/>
          <circle class="arc" cx="52" cy="52" r="46" stroke-dasharray="289.03" stroke-dashoffset="{{ '%.2f' | format(289.03 * (1 - q.score / 100)) }}"/></svg>
        <span>{{ q.score }}</span>
      </div>
      <div>
        <div class="k">Quality score</div>
        <div style="font-size:20px;font-weight:700;margin-top:4px">Grade {{ q.grade }} · {{ labels[q.grade] }}</div>
        <div class="muted" style="font-size:13px">{{ profile.warnings | length }} warnings · {{ summary.missing_cells_pct }}% missing · {{ summary.duplicate_rows }} duplicates</div>
      </div>
    </div>
    {% endif %}
    <div class="tile"><div class="k">Rows</div><div class="v">{{ "{:,}".format(summary.rows) }}</div></div>
    <div class="tile"><div class="k">Columns</div><div class="v">{{ summary.columns }}</div></div>
    <div class="tile"><div class="k">Missing cells</div><div class="v">{{ summary.missing_cells_pct }}%</div></div>
    <div class="tile"><div class="k">Duplicate rows</div><div class="v">{{ summary.duplicate_rows }}</div></div>
    <div class="tile"><div class="k">Warnings</div><div class="v">{{ profile.warnings | length }}</div></div>
    <div class="tile"><div class="k">{{ "Size on disk" if summary.engine == "spark" else "Memory" }}</div><div class="v">{{ summary.memory_bytes | filesize }}</div></div>
  </div>

  <h2>Warnings</h2>
  {% for w in profile.warnings %}<div class="issue">{{ w.message }}</div>{% else %}<p class="ok">No data-quality issues found.</p>{% endfor %}

  <h2>Columns</h2>
  <div class="card table-wrap" style="padding:0">
    <table>
      <tr><th>Name</th><th>Type</th><th>Missing</th><th>Unique</th></tr>
      {% for c in profile.columns %}
      <tr><td><a href="#col-{{ loop.index }}">{{ c.name }}</a></td><td><span class="kind {{ c.kind }}">{{ c.kind }}</span></td>
          <td>{{ c.missing_pct }}%</td><td>{{ c.unique }}</td></tr>
      {% endfor %}
    </table>
  </div>

  {% if overview_charts %}
  <h2>Overview</h2>
  {% for chart in overview_charts %}<div class="card"><div class="k">{{ chart.title }}</div><div class="chart" data-chart="{{ chart.id }}"></div></div>{% endfor %}
  {% endif %}

  <h2>Column details</h2>
  {% for c in profile.columns %}
  <section class="card" id="col-{{ loop.index }}">
    <div style="display:flex;justify-content:space-between;gap:10px;align-items:center">
      <strong style="font-size:15px;overflow-wrap:anywhere">{{ c.name }}</strong><span class="kind {{ c.kind }}">{{ c.kind }}</span>
    </div>
    <div class="col-grid">
      <dl>
        <dt>Missing</dt><dd>{{ c.missing }} ({{ c.missing_pct }}%)</dd>
        <dt>Unique</dt><dd>{{ c.unique }}</dd>
        {% if c.kind == "numeric" %}
          {% for key in ["mean", "std", "min", "p25", "median", "p75", "max", "skew", "outliers"] %}
            {% if c[key] is not none %}<dt>{{ key }}</dt><dd>{{ "%.4g" | format(c[key]) }}</dd>{% endif %}
          {% endfor %}
        {% elif c.kind == "datetime" %}
          <dt>From</dt><dd>{{ c.min }}</dd><dt>To</dt><dd>{{ c.max }}</dd><dt>Span</dt><dd>{{ c.span_days }} days</dd>
        {% elif c.kind == "text" %}
          <dt>Avg length</dt><dd>{{ c.avg_length }}</dd>
          {% for ex in c.examples %}<dt>Example</dt><dd>{{ ex }}</dd>{% endfor %}
        {% else %}
          {% for t in c.top[:5] %}<dt>{{ t.value }}</dt><dd>{{ t.count }}</dd>{% endfor %}
        {% endif %}
      </dl>
      {% if column_charts.get(c.name) %}<div class="chart" data-chart="{{ column_charts[c.name].id }}"></div>{% else %}<div></div>{% endif %}
    </div>
  </section>
  {% endfor %}

  <footer>Generated by DataDigest · automatic CSV profiling</footer>
</main>
<script>
  // tojson escapes <, > and & so user data cannot close this script tag.
  const CHARTS = {{ charts | tojson }};
  const grid = "rgba(148,163,184,0.10)";
  const axis = (a) => ({ ...(a || {}), gridcolor: grid, zerolinecolor: "rgba(148,163,184,0.18)" });
  for (const chart of CHARTS) {
    const el = document.querySelector(`[data-chart="${CSS.escape(chart.id)}"]`);
    if (!el || !window.Plotly) continue;
    const layout = { ...chart.figure.layout, title: undefined, margin: { ...chart.figure.layout.margin, t: 10 },
                     paper_bgcolor: "rgba(0,0,0,0)", plot_bgcolor: "rgba(0,0,0,0)",
                     font: { family: "Inter, system-ui, sans-serif", size: 12, color: "#93a1b4" },
                     xaxis: axis(chart.figure.layout.xaxis), yaxis: axis(chart.figure.layout.yaxis) };
    Plotly.newPlot(el, chart.figure.data, layout, { responsive: true, displaylogo: false, displayModeBar: false });
  }
</script>
</body>
</html>
